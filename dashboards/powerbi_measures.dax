// Paste ONE named measure at a time into Modeling > New measure.
// This is a measure catalog, not a single executable DAX query.
// Tables must use the exact dashboard_<name> query names and remain disconnected.
// Ratio divisions are display calculations; authoritative CSV components are integers.

KPI Value =
DIVIDE(SELECTEDVALUE(dashboard_kpis[numerator]), SELECTEDVALUE(dashboard_kpis[denominator]))

Completed Orders =
CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "completed_orders")

Unique Completed Customers =
CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "unique_completed_customers")

Observed Item Sales (hundredths) =
CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "observed_item_sales")

Observed Item Sales (source units) =
DIVIDE([Observed Item Sales (hundredths)], 100)

Average Order Value (hundredths) =
CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "average_order_value")

Average Order Value (source units) =
DIVIDE([Average Order Value (hundredths)], 100)

Observed Repeat Customer Rate =
DIVIDE(CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "repeat_customer_rate"), 100)

Delivered Order Rate =
DIVIDE(CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "delivered_order_rate"), 100)

All Observed Orders =
CALCULATE([KPI Value], REMOVEFILTERS(dashboard_kpis), dashboard_kpis[metric_key] = "all_orders")

Monthly Chart Sales (source units) =
DIVIDE(SUM(dashboard_monthly_sales[chart_item_sales_hundredths]), 100)

Monthly AOV (source units) =
DIVIDE(SUM(dashboard_monthly_sales[average_order_value_hundredths_numerator]),
       100 * SUM(dashboard_monthly_sales[average_order_value_hundredths_denominator]))

Segment Customers =
SUM(dashboard_customer_segments[customers])

Segment Sales (source units) =
DIVIDE(SUM(dashboard_customer_segments[item_sales_hundredths]), 100)

Segment Customer Share =
DIVIDE(SUM(dashboard_customer_segments[customer_share_percent_numerator]),
       100 * MAX(dashboard_customer_segments[customer_share_percent_denominator]))

Segment Sales Share =
DIVIDE(SUM(dashboard_customer_segments[sales_share_percent_numerator]),
       100 * MAX(dashboard_customer_segments[sales_share_percent_denominator]))

Average Customer Sales (source units) =
DIVIDE(SUM(dashboard_customer_segments[average_customer_sales_hundredths_numerator]),
       100 * SUM(dashboard_customer_segments[average_customer_sales_hundredths_denominator]))

Segment AOV (source units) =
DIVIDE(SUM(dashboard_customer_segments[average_order_value_hundredths_numerator]),
       100 * SUM(dashboard_customer_segments[average_order_value_hundredths_denominator]))

High Value One-Time Customers =
CALCULATE([Segment Customers], REMOVEFILTERS(dashboard_customer_segments),
          dashboard_customer_segments[segment] = "High-value one-time")

High Value One-Time Sales Share =
CALCULATE([Segment Sales Share], REMOVEFILTERS(dashboard_customer_segments),
          dashboard_customer_segments[segment] = "High-value one-time")

Pareto Customer Share =
IF(HASONEVALUE(dashboard_customer_concentration[target_customer_percent]),
   DIVIDE(MAX(dashboard_customer_concentration[actual_customer_percent_numerator]),
          100 * MAX(dashboard_customer_concentration[actual_customer_percent_denominator])))

Pareto Sales Share =
IF(HASONEVALUE(dashboard_customer_concentration[target_customer_percent]),
   DIVIDE(MAX(dashboard_customer_concentration[cumulative_sales_percent_numerator]),
          100 * MAX(dashboard_customer_concentration[cumulative_sales_percent_denominator])))

Customers Needed for 80% Sales =
CALCULATE(MAX(dashboard_customer_concentration[customers_selected]),
          REMOVEFILTERS(dashboard_customer_concentration),
          dashboard_customer_concentration[record_type] = "sales_80_threshold")

Customer Share Needed for 80% Sales =
CALCULATE(
    DIVIDE(MAX(dashboard_customer_concentration[actual_customer_percent_numerator]),
           100 * MAX(dashboard_customer_concentration[actual_customer_percent_denominator])),
    REMOVEFILTERS(dashboard_customer_concentration),
    dashboard_customer_concentration[record_type] = "sales_80_threshold")

New Cohort Customers =
CALCULATE(SUM(dashboard_cohorts[new_customers]), dashboard_cohorts[month_index] = 0,
          dashboard_cohorts[coverage_status] = "baseline_membership")

Eligible Three-Month Cohorts =
CALCULATE(DISTINCTCOUNT(dashboard_cohorts[cohort_month]), dashboard_cohorts[month_index] = 0,
          dashboard_cohorts[flag_insufficient_three_month_coverage] = 0,
          dashboard_cohorts[coverage_status] = "baseline_membership")

Eligible Three-Month Customers =
CALCULATE([New Cohort Customers], dashboard_cohorts[flag_insufficient_three_month_coverage] = 0)

Cohort Coverage Note =
VAR Cohorts = [Eligible Three-Month Cohorts]
RETURN
IF(ISBLANK(Cohorts) || Cohorts = 0,
   "No selected cohorts have common M1-M3 coverage",
   FORMAT(Cohorts, "0") & " eligible cohorts; " & FORMAT([Eligible Three-Month Customers], "#,##0") & " original customers")

M1 Return Rate =
CALCULATE(
    DIVIDE(SUM(dashboard_cohorts[retention_percent_numerator]),
           100 * SUM(dashboard_cohorts[retention_percent_denominator])),
    dashboard_cohorts[month_index] = 1,
    dashboard_cohorts[flag_insufficient_three_month_coverage] = 0,
    dashboard_cohorts[coverage_status] = "interior_observed")

M2 Return Rate =
CALCULATE(
    DIVIDE(SUM(dashboard_cohorts[retention_percent_numerator]),
           100 * SUM(dashboard_cohorts[retention_percent_denominator])),
    dashboard_cohorts[month_index] = 2,
    dashboard_cohorts[flag_insufficient_three_month_coverage] = 0,
    dashboard_cohorts[coverage_status] = "interior_observed")

M3 Return Rate =
CALCULATE(
    DIVIDE(SUM(dashboard_cohorts[retention_percent_numerator]),
           100 * SUM(dashboard_cohorts[retention_percent_denominator])),
    dashboard_cohorts[month_index] = 3,
    dashboard_cohorts[flag_insufficient_three_month_coverage] = 0,
    dashboard_cohorts[coverage_status] = "interior_observed")

Cohort Cell Return Rate =
VAR Status = SELECTEDVALUE(dashboard_cohorts[coverage_status])
RETURN
IF(HASONEVALUE(dashboard_cohorts[cohort_month]) && HASONEVALUE(dashboard_cohorts[month_index])
   && Status IN {"interior_observed", "baseline_membership"},
   DIVIDE(MAX(dashboard_cohorts[retention_percent_numerator]),
          100 * MAX(dashboard_cohorts[retention_percent_denominator])))

Cohort Cell Text =
VAR Status = SELECTEDVALUE(dashboard_cohorts[coverage_status])
RETURN
IF(HASONEVALUE(dashboard_cohorts[cohort_month]) && HASONEVALUE(dashboard_cohorts[month_index]),
   SWITCH(Status,
       "future_unobserved", "FU",
       "calendar_gap", "CG",
       "terminal_partial", "TP",
       "baseline_membership", "100% M0",
       "interior_observed", FORMAT([Cohort Cell Return Rate], "0.00%"),
       BLANK()))

Cohort Cell Background =
VAR Status = SELECTEDVALUE(dashboard_cohorts[coverage_status])
VAR Rate = [Cohort Cell Return Rate]
RETURN
SWITCH(Status,
    "future_unobserved", "#E5E7EB",
    "calendar_gap", "#FFF2CC",
    "terminal_partial", "#EDE4F7",
    "baseline_membership", "#DCE6F1",
    "interior_observed", SWITCH(TRUE(), Rate >= 0.01, "#8AC7B8", Rate >= 0.005, "#B9DDCC",
                                         Rate > 0, "#DDEFE4", "#F3FAF5"),
    "#FFFFFF")

Repeat Summary Value =
IF(SELECTEDVALUE(dashboard_repeat_timing[record_type]) = "summary",
   DIVIDE(SELECTEDVALUE(dashboard_repeat_timing[numerator]), SELECTEDVALUE(dashboard_repeat_timing[denominator])))

Median Days to Second Purchase =
CALCULATE([Repeat Summary Value], REMOVEFILTERS(dashboard_repeat_timing),
          dashboard_repeat_timing[record_type] = "summary",
          dashboard_repeat_timing[metric] = "median_days_to_second_purchase")

Repeat Window Share =
IF(SELECTEDVALUE(dashboard_repeat_timing[unit]) = "percent", DIVIDE([Repeat Summary Value], 100))

Repeat Interval Count =
IF(SELECTEDVALUE(dashboard_repeat_timing[record_type]) = "interval_bin"
   && HASONEVALUE(dashboard_repeat_timing[scope]), SUM(dashboard_repeat_timing[count]))

Category Sales (source units) =
IF(HASONEVALUE(dashboard_categories[customer_type]),
   DIVIDE(SUM(dashboard_categories[item_sales_hundredths]), 100))

Category Sales Share =
IF(HASONEVALUE(dashboard_categories[customer_type]),
   DIVIDE(SUM(dashboard_categories[sales_share_percent_numerator]),
          100 * MAX(dashboard_categories[sales_share_percent_denominator])))

Category Order Count =
IF(HASONEVALUE(dashboard_categories[customer_type]) && HASONEVALUE(dashboard_categories[category_key]),
   MAX(dashboard_categories[category_orders]))

Category Customer Count =
IF(HASONEVALUE(dashboard_categories[customer_type]) && HASONEVALUE(dashboard_categories[category_key]),
   MAX(dashboard_categories[category_customers]))

First-to-Second Transition Count =
SUM(dashboard_category_transition[order_transitions])

First-to-Second Transition Share =
DIVIDE(SUM(dashboard_category_transition[transition_share_percent_numerator]),
       100 * MAX(dashboard_category_transition[transition_share_percent_denominator]))

Status Order Count =
SUM(dashboard_order_status[orders])

Status Share of All Orders =
DIVIDE(SUM(dashboard_order_status[status_share_percent_numerator]),
       100 * MAX(dashboard_order_status[status_share_percent_denominator]))
