table dashboard_categories
	lineageTag: 6987c602-2306-4ee5-8ab9-e05073c80ee0

	measure 'Category Sales (source units)' =
			IF(HASONEVALUE(dashboard_categories[customer_type]),
			   DIVIDE(SUM(dashboard_categories[item_sales_hundredths]), 100))
		formatString: #,##0.00
		lineageTag: 3285c0d5-7950-4cde-9b61-6f292b48503f

	measure 'Category Sales Share' =
			IF(HASONEVALUE(dashboard_categories[customer_type]),
			   DIVIDE(SUM(dashboard_categories[sales_share_percent_numerator]),
			          100 * MAX(dashboard_categories[sales_share_percent_denominator])))
		formatString: 0.00%
		lineageTag: 966c77c3-6fa0-412e-8a6f-d5bfa6ef1460

	measure 'Category Order Count' =
			IF(HASONEVALUE(dashboard_categories[customer_type]) && HASONEVALUE(dashboard_categories[category_key]),
			   MAX(dashboard_categories[category_orders]))
		formatString: #,##0
		lineageTag: 8a024c10-3dc6-4fa8-a8c2-c801d613f5a5

	measure 'Category Customer Count' =
			IF(HASONEVALUE(dashboard_categories[customer_type]) && HASONEVALUE(dashboard_categories[category_key]),
			   MAX(dashboard_categories[category_customers]))
		formatString: #,##0
		lineageTag: 8021c100-9298-445a-8aa2-b1096be6e984

	column customer_type
		dataType: string
		lineageTag: ccb51051-cb25-4566-95d3-304f06b37c8f
		summarizeBy: none
		sourceColumn: customer_type

		annotation SummarizationSetBy = Automatic

	column product_category_name
		dataType: string
		lineageTag: e6ad5c83-c722-4f89-a6e5-27be20c1b407
		summarizeBy: none
