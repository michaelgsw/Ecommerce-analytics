table dashboard_monthly_sales
	lineageTag: 182d5c53-300b-4216-b874-247a60fdccf7

	measure 'Monthly Chart Sales (source units)' = DIVIDE(SUM(dashboard_monthly_sales[chart_item_sales_hundredths]), 100)
		formatString: #,##0.00
		lineageTag: 667a4291-f000-481b-ae23-95f76e473ad1

	measure 'Monthly AOV (source units)' =
			DIVIDE(SUM(dashboard_monthly_sales[average_order_value_hundredths_numerator]),
			       100 * SUM(dashboard_monthly_sales[average_order_value_hundredths_denominator]))
		formatString: #,##0.00
		lineageTag: 1137fb28-ac34-4465-98f1-dd6b8bd66c27

