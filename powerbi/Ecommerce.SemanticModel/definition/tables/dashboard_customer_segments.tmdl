table dashboard_customer_segments
	lineageTag: f2a7d1da-4fb7-490c-a3a3-111ea5726401

	measure 'Segment Customers' = SUM(dashboard_customer_segments[customers])
		formatString: #,##0
		lineageTag: 4607e40c-1018-44a8-9eb6-23320abbdddd

	measure 'Segment Sales (source units)' = DIVIDE(SUM(dashboard_customer_segments[item_sales_hundredths]), 100)
		formatString: #,##0.00
		lineageTag: 2156cea2-c9f8-41bd-89f1-a8129860c025

	measure 'Segment Customer Share' =
			DIVIDE(SUM(dashboard_customer_segments[customer_share_percent_numerator]),
			       100 * MAX(dashboard_customer_segments[customer_share_percent_denominator]))
		formatString: 0.00%
		lineageTag: 09f21721-1ed6-4425-a925-5dfac7e4b713

	measure 'Segment Sales Share' =
			DIVIDE(SUM(dashboard_customer_segments[sales_share_percent_numerator]),
			       100 * MAX(dashboard_customer_segments[sales_share_percent_denominator]))
		formatString: 0.00%
		lineageTag: 7326d851-c0d7-41c1-9a90-2df325c53087

	measure 'Average Customer Sales (source units)' =
			DIVIDE(SUM(dashboard_customer_segments[average_customer_sales_hundredths_numerator]),
			       100 * SUM(dashboard_customer_segments[average_customer_sales_hundredths_denominator]))
		formatString: #,##0.00
		lineageTag: 3cf95b7b-8a26-41b2-ba9b-2075b7607e8d

	measure 'Segment AOV (source units)' =
			DIVIDE(SUM(dashboard_customer_segments[average_order_value_hundredths_numerator]),
			       100 * SUM(dashboard_customer_segments[average_order_value_hundredths_denominator]))
		formatString: #,##0.00
		lineageTag: 2db221de-004b-4e46-8d68-326589fed54c

	measure 'High Value One-Time Customers' =
			CALCULATE([Segment Customers], REMOVEFILTERS(dashboard_customer_segments),
			          dashboard_customer_segments[segment] = "High-value one-time")
		formatString: #,##0
		lineageTag: 41fdb668-2b34-4334-a05d-f36dbf07c09c

	measure 'High Value One-Time Sales Share' =
			CALCULATE([Segment Sales Share], REMOVEFILTERS(dashboard_customer_segments),
			          dashboard_customer_segments[segment] = "High-value one-time")
		formatString: 0.00%
		lineageTag: 04fecb42-d96b-4347-bf65-435f65cb551d

