table dashboard_repeat_timing
	lineageTag: f85bfa04-dd07-40bb-bc0b-7a52452b0f19

	measure 'Repeat Summary Value' =
			IF(SELECTEDVALUE(dashboard_repeat_timing[record_type]) = "summary",
			   DIVIDE(SELECTEDVALUE(dashboard_repeat_timing[numerator]), SELECTEDVALUE(dashboard_repeat_timing[denominator])))
		lineageTag: 6a5cae81-31f5-4782-99cb-78b7df1e8acb

	measure 'Median Days to Second Purchase' =
			CALCULATE([Repeat Summary Value], REMOVEFILTERS(dashboard_repeat_timing),
			          dashboard_repeat_timing[record_type] = "summary",
			          dashboard_repeat_timing[metric] = "median_days_to_second_purchase")
		formatString: 0.0
		lineageTag: 2ee0bda1-6520-4e11-86bc-4980f6ae9a23

	measure 'Repeat Window Share' = IF(SELECTEDVALUE(dashboard_repeat_timing[unit]) = "percent", DIVIDE([Repeat Summary Value], 100))
		formatString: 0.00%
		lineageTag: 7fc98020-1358-43f1-82b4-3ec3b446c48a

	measure 'Repeat Interval Count' =
			IF(SELECTEDVALUE(dashboard_repeat_timing[record_type]) = "interval_bin"
			   && HASONEVALUE(dashboard_repeat_timing[scope]), SUM(dashboard_repeat_timing[count]))
		formatString: #,##0
		lineageTag: 64ef1c92-2835-449d-9a43-e95a923f1722

	column record_type
		dataType: string
		lineageTag: 842f8606-93fa-495e-b775-5dda65acb261
		summarizeBy: none
		sourceColumn: record_type

		annotation SummarizationSetBy = Automatic

	column scope
		dataType: string
		lineageTag: b8d66154-d022-4bee-b253-b4112a73f4dd
		summarizeBy: none
		sourceColumn: scope

