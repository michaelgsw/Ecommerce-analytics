table dashboard_category_transition
	lineageTag: b848cca6-ec71-4b88-a320-dc44cef45ba8

	measure 'First-to-Second Transition Count' = SUM(dashboard_category_transition[order_transitions])
		formatString: #,##0
		lineageTag: f0a6862d-eddf-4d59-99d0-5755b3591268

	measure 'First-to-Second Transition Share' =
			DIVIDE(SUM(dashboard_category_transition[transition_share_percent_numerator]),
			       100 * MAX(dashboard_category_transition[transition_share_percent_denominator]))
		formatString: 0.00%
		lineageTag: 054acd0c-48a9-4847-a9d6-7abd1e379d51

