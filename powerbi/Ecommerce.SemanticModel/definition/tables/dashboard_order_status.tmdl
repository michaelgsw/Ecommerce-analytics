table dashboard_order_status
	lineageTag: ec12a4a5-be14-4492-94d5-6cfe2a157e1f

	measure 'Status Order Count' = SUM(dashboard_order_status[orders])
		formatString: #,##0
		lineageTag: f0f32306-9323-4a1d-bab7-ccc4a65730c0

	measure 'Status Share of All Orders' =
			DIVIDE(SUM(dashboard_order_status[status_share_percent_numerator]),
			       100 * MAX(dashboard_order_status[status_share_percent_denominator]))
		formatString: #,##0
		lineageTag: e7022469-ced7-4e7b-9ea6-5737c2b982bb

	column order_status
		dataType: string
		lineageTag: f056a1d9-e1ec-467d-b963-f738aa5744f4
