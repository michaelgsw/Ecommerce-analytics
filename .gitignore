# Keep source and generated data local; preserve empty folder placeholders
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/analytics/*
!/data/analytics/.gitkeep
/data/dashboard/*
!/data/dashboard/.gitkeep
/data/database/*
!/data/database/.gitkeep
# Machine-readable validation evidence is regenerated by the pipelines.
# Keep reviewed Markdown validation reports and business findings.
/reports/*_validation.json
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Preserve PBIP/PBIR/TMDL source; exclude Desktop-local settings and cached data
**/.pbi/
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.abf
*.pbix
*.pbit

